  "scripts": {
    "start": "NODE_OPTIONS=--max-old-space-size=4096 react-app-rewired start",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 react-app-rewired build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "prettier:cli": "prettier \"src/**/*.js\" \"**/*.json\"",
    "prettier": "npm run prettier:cli -l",
    "prettier:fix": "npm run prettier:cli --write",
    "eslint": "eslint src -c .eslintrc.json --ext js,jsx --max-warnings=0",
    "eslint:fix": "npm run eslint --fix",
    "prepare": "husky install",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"**/*.{js,jsx}\"",
    "lint:fix": "eslint \"**/*.{js,jsx}\" --fix"
  },
  "jest": {
    "transformIgnorePatterns": [
      "/node_modules/(?!(axios|double-metaphone|metaphone|@mui|@tekdi)/)"
    ],
    "moduleNameMapper": {
      "@mui/material/index$": "<rootDir>/node_modules/@mui/material/node/index.js",
      "react-router-dom/dist/index$": "<rootDir>/node_modules/react-router-dom/dist/main.js",
      "^number-flow/lite$": "<rootDir>/node_modules/number-flow/dist/lite.js",
      "^number-flow/plugins$": "<rootDir>/node_modules/number-flow/dist/plugins.js",
      "^@number-flow/react$": "<rootDir>/node_modules/@number-flow/react/dist/index.js",
      "^esm-env/(.*)$": "<rootDir>/src/__jest_mocks__/esm-env-browser.js",
      "^esm-env$": "<rootDir>/src/__jest_mocks__/esm-env.js"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "ignorePatterns": [
      "build/",
      "public/js/jquery-3.7.0.min.js"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.28.5",
    "@mui/styles": "^5.15.10",
    "autoprefixer": "^10.4.23",
    "customize-cra": "^1.0.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^3.4.0",
    "husky": "^9.0.11",
    "lint-staged": "^11.0.0",
    "postcss": "^8.5.6",
    "prettier": "^2.3.2",
    "react": "^18.2.0",
    "react-app-rewired": "^2.2.1",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7"
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "npx eslint --fix",
      "npx prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "npx lint-staged"
    }
  }
}
